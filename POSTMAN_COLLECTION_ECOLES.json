		{
			"name": "13. Prévisualiser en-tête PDF",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}/preview-header",
