{
	"info": {
		"_postman_id": "ecoles-api-collection",
		"name": "API Écoles - EnrolCM (Tests Complets)",
		"description": "Collection complète pour tester l'API de gestion des écoles",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "ecole_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Lister toutes les écoles",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/ecoles?page=1&per_page=15",
					"host": ["{{base_url}}"],
					"path": ["ecoles"],
					"query": [
						{
							"key": "page",
							"value": "1",
							"description": "Numéro de page"
						},
						{
							"key": "per_page",
							"value": "15",
							"description": "Nombre d'éléments par page"
						},
						{
							"key": "region",
							"value": "CENTRE",
							"description": "Filtrer par région",
							"disabled": true
						},
						{
							"key": "est_actif",
							"value": "1",
							"description": "Filtrer par statut actif",
							"disabled": true
						}
					]
				},
				"description": "Récupère la liste paginée de toutes les écoles avec filtres optionnels"
			},
			"response": []
		},
		{
			"name": "2. Lister les écoles actives",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/ecoles/actives",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "actives"]
				},
				"description": "Récupère uniquement les écoles actives (pour les sélections)"
			},
			"response": []
		},
		{
			"name": "3. Créer une nouvelle école",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    pm.collectionVariables.set('ecole_id', jsonData.data.id);",
							"    console.log('École créée avec ID: ' + jsonData.data.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"code_ecole\": \"ESSTIC\",\n    \"libelle_ecole\": \"École Supérieure des Sciences et Techniques de l'Information et de la Communication\",\n    \"region\": \"CENTRE\",\n    \"localisation\": \"Yaoundé\",\n    \"email_ecole\": \"contact@esstic.cm\",\n    \"telephone_ecole\": \"+237222789012\",\n    \"siteweb_ecole\": \"https://esstic.cm\",\n    \"devise\": \"Communiquer pour Innover\",\n    \"bp_ecole\": \"BP 1234\",\n    \"est_actif\": true\n}"
				},
				"url": {
					"raw": "{{base_url}}/ecoles",
					"host": ["{{base_url}}"],
					"path": ["ecoles"]
				},
				"description": "Crée une nouvelle école. L'ID est sauvegardé automatiquement dans la variable ecole_id."
			},
			"response": []
		},
		{
			"name": "4. Voir une école par ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "{{ecole_id}}"]
				},
				"description": "Récupère les détails d'une école par son ID"
			},
			"response": []
		},
		{
			"name": "5. Voir une école par code",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/ecoles/code/ENSP",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "code", "ENSP"]
				},
				"description": "Récupère les détails d'une école par son code"
			},
			"response": []
		},
		{
			"name": "6. Modifier une école",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"libelle_ecole\": \"École Supérieure des Sciences et Techniques de l'Information - Mise à jour\",\n    \"email_ecole\": \"info@esstic.cm\",\n    \"telephone_ecole\": \"+237222789013\",\n    \"devise\": \"Innovation et Communication\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "{{ecole_id}}"]
				},
				"description": "Modifie les informations d'une école existante"
			},
			"response": []
		},
		{
			"name": "7. Activer/Désactiver une école",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}/toggle-status",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "{{ecole_id}}", "toggle-status"]
				},
				"description": "Bascule le statut actif/inactif d'une école"
			},
			"response": []
		},
		{
			"name": "8. Upload logo école",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": [],
							"description": "Fichier logo (image)"
						},
						{
							"key": "type",
							"value": "logo",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}/upload-file",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "{{ecole_id}}", "upload-file"]
				},
				"description": "Upload le logo de l'école (PNG, JPG, JPEG, max 2MB)"
			},
			"response": []
		},
		{
			"name": "9. Upload emblème école",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": [],
							"description": "Fichier emblème (image)"
						},
						{
							"key": "type",
							"value": "embleme",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}/upload-file",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "{{ecole_id}}", "upload-file"]
				},
				"description": "Upload l'emblème de l'école (PNG, JPG, JPEG, max 2MB)"
			},
			"response": []
		},
		{
			"name": "10. Supprimer logo école",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"logo\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}/delete-file",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "{{ecole_id}}", "delete-file"]
				},
				"description": "Supprime le logo de l'école"
			},
			"response": []
		},
		{
			"name": "11. Supprimer emblème école",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"embleme\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/ecoles/{{ecole_id}}/delete-file",
					"host": ["{{base_url}}"],
					"path": ["ecoles", "{{ecole_id}}", "delete-file"]
				},
				"description": "Supprime l'emblème de l'école"
			},
			"response": []
		},
