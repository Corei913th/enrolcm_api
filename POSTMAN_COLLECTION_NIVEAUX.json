{
  "info": {
    "name": "API Niveaux - EnrolCM",
    "description": "Collection complète pour tester l'API des niveaux",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Créer un niveau",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code_niveau\": \"L1\",\n  \"libelle_niveau\": \"Licence 1\",\n  \"filiere_id\": \"{{filiere_id}}\",\n  \"ordre\": 1,\n  \"desc_niveau\": \"Première année de licence\",\n  \"est_actif\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux"]
        }
      },
      "response": []
    },
    {
      "name": "2. Liste des niveaux (paginée)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux?per_page=15",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux"],
          "query": [
            {
              "key": "per_page",
              "value": "15"
            },
            {
              "key": "est_actif",
              "value": "1",
              "disabled": true
            },
            {
              "key": "filiere_id",
              "value": "{{filiere_id}}",
              "disabled": true
            },
            {
              "key": "search",
              "value": "Licence",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Afficher un niveau par ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux/{{niveau_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux", "{{niveau_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "4. Afficher un niveau par code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux/code/L1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux", "code", "L1"]
        }
      },
      "response": []
    },
    {
      "name": "5. Mettre à jour un niveau",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code_niveau\": \"L1\",\n  \"libelle_niveau\": \"Licence 1 - Année Fondamentale\",\n  \"filiere_id\": \"{{filiere_id}}\",\n  \"ordre\": 1,\n  \"desc_niveau\": \"Première année de licence avec cours fondamentaux\",\n  \"est_actif\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux/{{niveau_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux", "{{niveau_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "6. Toggle statut niveau",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux/{{niveau_id}}/toggle-status",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux", "{{niveau_id}}", "toggle-status"]
        }
      },
      "response": []
    },
    {
      "name": "7. Liste des niveaux actifs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux/actifs",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux", "actifs"]
        }
      },
      "response": []
    },
    {
      "name": "8. Supprimer un niveau",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/niveaux/{{niveau_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "niveaux", "{{niveau_id}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "niveau_id",
      "value": ""
    },
    {
      "key": "filiere_id",
      "value": ""
    }
  ]
}
