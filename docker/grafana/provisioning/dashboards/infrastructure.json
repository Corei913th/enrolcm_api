{
  "title": "Infrastructure",
  "uid": "infra",
  "version": 1,
  "schemaVersion": 36,
  "panels": [
    {
      "title": "CPU Usage (containers)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"enrolcm_.*\"}[1m]) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "title": "Memory Usage (containers)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"enrolcm_.*\"} / 1048576",
          "legendFormat": "{{name}}"
        }
      ],
      "unit": "MB"
    },
    {
      "title": "Node CPU",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)"
        }
      ]
    },
    {
      "title": "Node Memory",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100"
        }
      ],
      "unit": "percent"
    },
    {
      "title": "Nginx Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "active"
        }
      ]
    },
    {
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"enrolcm_db\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    }
  ]
}
