{
  "info": {
    "name": "API Départements - EnrolCM",
    "description": "Collection complète pour tester l'API des départements",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Créer un département",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code_departement\": \"INFO\",\n  \"libelle_departement\": \"Département Informatique\",\n  \"ecole_id\": \"{{ecole_id}}\",\n  \"desc_departement\": \"Département spécialisé en informatique\",\n  \"est_actif\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/departements",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements"]
        }
      },
      "response": []
    },
    {
      "name": "2. Liste des départements (paginée)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/departements?per_page=15",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements"],
          "query": [
            {
              "key": "per_page",
              "value": "15"
            },
            {
              "key": "est_actif",
              "value": "1",
              "disabled": true
            },
            {
              "key": "ecole_id",
              "value": "{{ecole_id}}",
              "disabled": true
            },
            {
              "key": "search",
              "value": "Info",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Afficher un département par ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/departements/{{departement_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements", "{{departement_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "4. Afficher un département par code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/departements/code/INFO",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements", "code", "INFO"]
        }
      },
      "response": []
    },
    {
      "name": "5. Mettre à jour un département",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code_departement\": \"INFO\",\n  \"libelle_departement\": \"Département Informatique et Réseaux\",\n  \"ecole_id\": \"{{ecole_id}}\",\n  \"desc_departement\": \"Département spécialisé en informatique et réseaux\",\n  \"est_actif\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/departements/{{departement_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements", "{{departement_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "6. Toggle statut département",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/departements/{{departement_id}}/toggle-status",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements", "{{departement_id}}", "toggle-status"]
        }
      },
      "response": []
    },
    {
      "name": "7. Liste des départements actifs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/departements/actifs",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements", "actifs"]
        }
      },
      "response": []
    },
    {
      "name": "8. Supprimer un département",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/departements/{{departement_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "departements", "{{departement_id}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "departement_id",
      "value": ""
    },
    {
      "key": "ecole_id",
      "value": ""
    }
  ]
}
