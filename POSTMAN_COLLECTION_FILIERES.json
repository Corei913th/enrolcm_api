{
  "info": {
    "name": "API Filières - EnrolCM",
    "description": "Collection complète pour tester l'API des filières",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Créer une filière",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code_filiere\": \"GL\",\n  \"libelle_filiere\": \"Génie Logiciel\",\n  \"departement_id\": \"{{departement_id}}\",\n  \"desc_filiere\": \"Filière spécialisée en développement logiciel\",\n  \"est_actif\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/filieres",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres"]
        }
      },
      "response": []
    },
    {
      "name": "2. Liste des filières (paginée)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/filieres?per_page=15",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres"],
          "query": [
            {
              "key": "per_page",
              "value": "15"
            },
            {
              "key": "est_actif",
              "value": "1",
              "disabled": true
            },
            {
              "key": "departement_id",
              "value": "{{departement_id}}",
              "disabled": true
            },
            {
              "key": "search",
              "value": "Génie",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Afficher une filière par ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/filieres/{{filiere_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres", "{{filiere_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "4. Afficher une filière par code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/filieres/code/GL",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres", "code", "GL"]
        }
      },
      "response": []
    },
    {
      "name": "5. Mettre à jour une filière",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code_filiere\": \"GL\",\n  \"libelle_filiere\": \"Génie Logiciel et Systèmes\",\n  \"departement_id\": \"{{departement_id}}\",\n  \"desc_filiere\": \"Filière spécialisée en développement logiciel et systèmes\",\n  \"est_actif\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/filieres/{{filiere_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres", "{{filiere_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "6. Toggle statut filière",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/filieres/{{filiere_id}}/toggle-status",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres", "{{filiere_id}}", "toggle-status"]
        }
      },
      "response": []
    },
    {
      "name": "7. Liste des filières actives",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/filieres/actives",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres", "actives"]
        }
      },
      "response": []
    },
    {
      "name": "8. Supprimer une filière",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/filieres/{{filiere_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "filieres", "{{filiere_id}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "filiere_id",
      "value": ""
    },
    {
      "key": "departement_id",
      "value": ""
    }
  ]
}
